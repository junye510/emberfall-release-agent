# Copy to .env and fill in only the provider you run. Never commit .env.
# The CLI loads .env from the current directory without overriding variables
# that are already set.

# Recommended real model: Z.ai / Zhipu glm-4.7-flash (free, tool calls and
# structured output). The OpenMinion preset's own default is the paid glm-5.2,
# so this project passes glm-4.7-flash unless OPENMINION_MODEL is set.
# The key is read only from ZAI_API_KEY.
#
# International keys from z.ai use the preset endpoint:
#   https://api.z.ai/api/paas/v4/
# Keys from bigmodel.cn (China) need that site's OpenAI-compatible endpoint:
#   ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# OPENMINION_BASE_URL overrides ZAI_BASE_URL when both are set.
# --base-url overrides both.
OPENMINION_PROVIDER=zai
OPENMINION_MODEL=glm-4.7-flash
ZAI_API_KEY=
# ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# DeepSeek alternative. An account with no balance returns
# ProviderError 402 insufficient_balance_error.
# Alternate model: deepseek-v4-pro
# OPENMINION_PROVIDER=deepseek
# OPENMINION_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=

# Offline fallback with no key. Echo does not call a hosted model.
# The release agent installs an in-process completer on echo so the run still
# exercises tools, sessions, structured output, and approval.
# OPENMINION_PROVIDER=echo

# Optional endpoint override for any hosted provider.
# OPENMINION_BASE_URL=

# Caller-owned turn deadline in seconds. The SDK raises TurnTimeoutError past this.
# Leave unset to use the CLI default: 120 for echo, 300 for a hosted provider
# such as Z.ai. glm-4.7-flash can spend a long stretch in provider retries.
# OPENMINION_TIMEOUT_SECONDS=300

# Unattended approval for the write turn: ask, yes, or no.
# The --approval flag overrides this.
# RELEASE_AGENT_APPROVAL=ask

# Other hosted providers. Set the key that matches OPENMINION_PROVIDER.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# CORTENSOR_API_KEY=
