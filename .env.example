# Copy to .env and fill in only the provider you run. Never commit .env.
# The CLI loads .env from the current directory without overriding variables
# that are already set.

# Offline default. The echo provider does not call a hosted model.
# The release agent installs an in-process completer on echo so the run still
# exercises tools, sessions, structured output, and approval.
OPENMINION_PROVIDER=echo

# Ignored for echo (the SDK rejects runtime model overrides on echo).
# Set this when OPENMINION_PROVIDER is a real provider.
# OPENMINION_MODEL=gpt-4.1-mini

# Optional endpoint override (Ollama, a Cortensor router, or another compatible host).
# OPENMINION_BASE_URL=http://127.0.0.1:11434

# Caller-owned turn deadline. The SDK raises TurnTimeoutError past this.
OPENMINION_TIMEOUT_SECONDS=120

# Unattended approval for the write turn: ask, yes, or no.
# The --approval flag overrides this.
# RELEASE_AGENT_APPROVAL=ask

# Hosted providers. Set the key that matches OPENMINION_PROVIDER.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# CORTENSOR_API_KEY=
